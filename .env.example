# ==============================================================================
# Environment configuration for the E-commerce MVP.
# Copy to `.env` (`cp .env.example .env`) before `docker compose up`.
# ==============================================================================

# ---- Postgres (the `db` service reads these) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce

# ---- Backend ----
# Inside docker-compose the host is the service name `db`. For local dev
# (uvicorn on the host) use localhost:5432 instead.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ecommerce

# Secret used to sign JWTs. MUST be changed in production (use a long random value).
JWT_SECRET=dev-secret-change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of origins allowed by CORS (the Angular dev server, etc.).
CORS_ORIGINS=http://localhost:4200,http://localhost,http://localhost:80

# Run demo-data seeding on first startup.
RUN_SEED=true

# ---- AI customer support (Anthropic) ----
# Server-side ONLY — never expose this to the Angular app.
# Leave empty to run the chat in offline demo mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Frontend ----
# Base URL the Angular app uses to reach the API (used by the prod build/nginx).
API_BASE_URL=http://localhost:8000
